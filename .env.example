PRIMARY_API_KEY=your_primary_api_key_here
PRIMARY_MODEL=deepseek-v4-flash
PRIMARY_BASE_URL=https://api.deepseek.com/v1
# Thinking mode for primary and multimodal requests. `none` disables reasoning;
# `high` or `max` enables it. `none` is the default.
REASONING_EFFORT=none
# Maximum number of tokens generated in one AI response.
AI_MAX_OUTPUT_TOKENS=200000

MULTIMODAL_API_KEY=your_multimodal_api_key_here
MULTIMODAL_MODEL=your_multimodal_model
MULTIMODAL_BASE_URL=https://your-multimodal-provider.example/v1

WEB_SCREENSHOT_API_URL=https://snap.idsiber.com/api/screenshot

CONTEXT_OPTIMIZE=true
CONTEXT_OPTIMIZE_MODE=summary
# Model context window in tokens; set this to match the active model.
CONTEXT_WINDOW=200000
# Create/update an AI summary when the last prompt reaches this ratio of the window.
CONTEXT_OPTIMIZE_THRESHOLD=0.8
# Keep this many recent user turns in full in every request.
CONTEXT_OPTIMIZE_KEEP_RECENT=2
# Limits for each AI history-summary request.
CONTEXT_SUMMARY_MAX_TOKENS=1200
CONTEXT_SUMMARY_MAX_INPUT_CHARS=120000
AGENT_MAX_ITERATIONS=50
LLM_REQUEST_LOGGING=false

DATA_DIR=data
PORT=3000
# Maximum size per workspace file upload (default: 50 MiB; hard cap: 250 MiB).
WORKSPACE_UPLOAD_MAX_BYTES=52428800

# --- App / Auth ---
APP_URL=http://localhost:3000
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=7
ADMIN_EMAILS=admin@example.com,other-admin@example.com
PASSWORD_MIN_LENGTH=8
VERIFICATION_TOKEN_HOURS=24

# --- Anonymous mode ---
ANON_PROJECT_LIMIT=3
ANON_MAX_AGE_DAYS=30

# --- Mail (SMTP sender) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=craft@idsiber.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=craft@idsiber.com
MAIL_FROM_NAME="Craft idSiber"
